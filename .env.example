# Required — copy to .env and fill in.
DISCORD_TOKEN=
DISCORD_APP_ID=

# Your home server's guild ID. Set it so the /summarize command registers instantly;
# global registration can take up to an hour to propagate.
DISCORD_GUILD_ID=

# Absolute path to the mounted vault ON THE HOST running the container. This is the same
# Samba share your laptop and desktop mount.
VAULT_HOST_PATH=/mnt/vault

# Inference host. The Mac Mini, over the LAN (ADR 0002). No cloud APIs.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Optional overrides.
NOTE_SUBDIR=Video Notes
MAX_CONCURRENT_JOBS=2
QUEUE_DEPTH=10
LOG_LEVEL=info
